#!/bin/sh
set -e

if [ $# -ne 1 ]; then
    echo "Usage: release <release name>"
    exit 1
fi

podman run -v $(pwd):/mnt:rw -i -t rust:bookworm sh -c "cd /mnt && cargo build --target x86_64-unknown-linux-gnu --release"
git tag $1
git push origin --tags
gh release new $1 --notes-from-tag -t $1 ./target/x86_64-unknown-linux-gnu/release/oktebot
echo "Published new release"